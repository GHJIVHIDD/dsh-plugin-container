{
  "name": "@dsh-community/dsh-plugin-container",
  "version": "1.0.2",
  "description": "DeepSeek Harness 的 Docker 容器沙箱部署级插件(与 dsh-plugin-vm-sandbox 全能力对齐):39 个 docker_* 模型工具、快照/回滚、文件传输、端口转发、后台任务、审计、共享/配额/回收、网络策略、多容器并行执行与华丽原生 UI。无需 OrbStack,Linux/Windows/macOS 均可使用。",
  "type": "module",
  "scripts": {
    "prepare": "node ./scripts/prepare.mjs",
    "verify": "node scripts/verify.mjs",
    "smoke": "node scripts/smoke.mjs",
    "pack": "node scripts/package.mjs"
  },
  "main": "dsh-plugin-container/lib/index.js",
  "types": "dsh-plugin-container/lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dsh-plugin-container/lib/types/index.d.ts",
      "default": "./dsh-plugin-container/lib/index.js"
    },
    "./client": "./dsh-plugin-container/lib/client.js",
    "./cordis.patch.yml": "./dsh-plugin-container/cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dsh-plugin-container/lib",
    "dsh-plugin-container/cordis.patch.yml",
    "scripts"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "docker",
    "container",
    "sandbox",
    "plugin",
    "web",
    "native-ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./dsh-plugin-container/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
